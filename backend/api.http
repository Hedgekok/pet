@baseUrl = http://127.0.0.1:3000
@token = REPLACE_ME
@animalId = REPLACE_ME

### Health check
GET {{baseUrl}}/health

### OTP start (DEV: check server logs for code)
POST {{baseUrl}}/auth/start
Content-Type: application/json

{
  "phone": "89990001122"
}

### OTP verify (replace code from server logs)
POST {{baseUrl}}/auth/verify
Content-Type: application/json

{
  "phone": "89990001122",
  "code": "REPLACE_ME"
}

### My animals (JWT protected)
GET {{baseUrl}}/me/animals
Authorization: Bearer {{token}}

### Ingest animal (basic, no owner)
POST {{baseUrl}}/ingest/animal
Content-Type: application/json

{
  "name": "Barsik",
  "species": "cat",
  "breed": "mixed",
  "birthDate": "2022-05-01T00:00:00.000Z",
  "microchipId": "RU-123-456-789",
  "microchipStandard": "ISO11784/11785",
  "microchipSource": "CLINIC"
}

### Ingest animal linked to owner phone
POST {{baseUrl}}/ingest/animal
Content-Type: application/json

{
  "name": "Barsik",
  "species": "cat",
  "breed": "mixed",
  "birthDate": "2022-05-01T00:00:00.000Z",
  "microchipId": "RU-123-456-789",
  "microchipStandard": "ISO11784/11785",
  "microchipSource": "CLINIC",
  "ownerPhone": "89990001122"
}

### Ingest event (uses {{animalId}})
POST {{baseUrl}}/ingest/event
Content-Type: application/json

{
  "animalId": "{{animalId}}",
  "clinic": { "name": "HappyVet", "externalKey": "happyvet-001" },
  "type": "VACCINATION",
  "occurredAt": "2026-01-10T10:30:00.000Z",
  "source": "CLINIC",
  "data": {
    "vaccine": "Rabies",
    "batch": "RB-2026-01",
    "nextDueAt": "2027-01-10T00:00:00.000Z",
    "notes": "No adverse reactions"
  }
}

### Timeline (uses {{animalId}})
GET {{baseUrl}}/animals/{{animalId}}/timeline

### Match-candidate scenario: ingest animal A (owner phone + clinic refs)
POST {{baseUrl}}/ingest/animal
Content-Type: application/json

{
  "ownerPhone": "89990001122",
  "name": "Barsik",
  "species": "cat",
  "breed": "mixed",
  "birthDate": "2022-05-01T00:00:00.000Z",
  "clinic": { "name": "HappyVet", "externalKey": "happyvet-001" },
  "externalAnimalId": "HV-1001"
}

### Match-candidate scenario: ingest animal B (similar fields, different externalAnimalId)
POST {{baseUrl}}/ingest/animal
Content-Type: application/json

{
  "ownerPhone": "89990001122",
  "name": "Barsik",
  "species": "cat",
  "breed": "mixed",
  "birthDate": "2022-05-01T00:00:00.000Z",
  "clinic": { "name": "HappyVet", "externalKey": "happyvet-001" },
  "externalAnimalId": "HV-1002"
}

### Match candidates (JWT protected)
GET {{baseUrl}}/me/match-candidates
Authorization: Bearer {{token}}

### DEV ONLY: dev-token (do not use in main flow)
POST {{baseUrl}}/auth/dev-token
Content-Type: application/json

{
  "phone": "+79990001122"
}

### DEV ONLY: auth ping
GET {{baseUrl}}/auth/ping
